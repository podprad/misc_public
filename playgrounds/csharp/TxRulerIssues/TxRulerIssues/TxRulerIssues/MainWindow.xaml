<Window x:Class="TxRulerIssues.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TxRulerIssues"
        xmlns:wpf="clr-namespace:TXTextControl.WPF;assembly=TXTextControl.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Button Margin="4" Width="250" Height="50" Click="ShowWindowed" Content="Show in WPF Window (works fine)"></Button>
        
        <Button Margin="4" Width="250" Height="50" Click="ShowInHost" Content="Show in host (ruler throws exception)"></Button>
    </StackPanel>
</Window>
