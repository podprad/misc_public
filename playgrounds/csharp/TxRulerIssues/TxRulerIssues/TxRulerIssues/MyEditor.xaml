<UserControl x:Class="TxRulerIssues.MyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TxRulerIssues"
             xmlns:wpf="clr-namespace:TXTextControl.WPF;assembly=TXTextControl.WPF"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <DockPanel Grid.Column="0">
            <wpf:ButtonBar x:Name="ButtonBar" />
            <wpf:StatusBar x:Name="StatusBar" />
            <wpf:RulerBar x:Name="RulerBar"></wpf:RulerBar>
            <wpf:RulerBar x:Name="VerticalRulerBar" DockPanel.Dock="Right"></wpf:RulerBar>

            <wpf:TextControl x:Name="TXTextControl" RulerBar="RulerBar" VerticalRulerBar="VerticalRulerBar" ButtonBar="ButtonBar" StatusBar="StatusBar" />
        </DockPanel>
    </Grid>
</UserControl>
